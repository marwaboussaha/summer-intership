{
  "name": "voicecraft-backend",
  "version": "1.0.0",
  "description": "Backend Node.js/Express qui reçoit une transcription vocale, construit un prompt et interroge l'API Groq pour générer une action/app.",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:coverage": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.3",
    "mongodb": "^7.5.0",
    "mongoose": "^9.9.1",
    "openai": "^7.3.0",
    "puppeteer": "^25.6.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "supertest": "^7.2.2"
  },
  "overrides": {
    "proxy-addr": "^2.0.8"
  },
  "jest": {
    "testEnvironment": "node",
    "transform": {},
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "coverageDirectory": "coverage",
    "coverageReporters": [
      "lcov",
      "text-summary"
    ],
    "collectCoverageFrom": [
      "routes/**/*.js",
      "utils/**/*.js",
      "services/**/*.js",
      "sandbox/services/**/*.js",
      "!**/node_modules/**",
      "!sandboxes/**",
      "!sandbox/template/**"
    ],
    "coveragePathIgnorePatterns": [
      "/node_modules/",
      "/sandboxes/",
      "/sandbox/template/"
    ]
  }
}